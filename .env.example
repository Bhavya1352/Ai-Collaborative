# ------------------------------------------------------------------------------
# Lumen - Environment Configuration Example
# Copy this file to '.env' and fill in your credentials.
# ------------------------------------------------------------------------------

# Firebase Web Application configuration
# SECURITY NOTE: Firebase API keys are safe to expose in frontend as they are restricted by Firebase console rules
# Ensure you have proper Firebase Security Rules configured (see firestore.rules)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Google Gemini AI API Configuration
# SECURITY NOTE: This API key is exposed in the frontend. For production:
# 1. Restrict the API key in Google Cloud Console to only allow specific domains
# 2. Set usage quotas and rate limits
# 3. Consider implementing a backend proxy for API calls
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Real-time WebSocket Collaboration URL (e.g. Socket.io server)
VITE_SOCKET_URL=http://localhost:3001

# GitHub Personal Access Token (optional - for higher API rate limits)
# Get one from: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=YOUR_GITHUB_TOKEN (optional)
